---
interface Props {
  theme: 'light' | 'dark';
}

const { theme } = Astro.props;
const badges = ['8+ años', 'Google Ad Manager', 'Header Bidding', 'Xandr', 'Programática'];
---

<section class:list={['concept', theme]} aria-label="Anuncio del portfolio de José Antonio López Molina">
  <div class="topline">
    <span class="advertiser">PUBLICIDAD · JOSÉ ANTONIO / PORTFOLIO</span>
    <div class="controls">
      <span class="ad-label">ANUNCIO</span>
      <button class="close" type="button" aria-label="Cerrar anuncio">×</button>
    </div>
  </div>
  <div class="body">
    <div class="message">
      <span class="kicker">PERFIL PROFESIONAL / ADTECH</span>
      <h2>José Antonio<br />López Molina<span class="period">.</span></h2>
      <p>Profesional de publicidad digital y tecnología programática.</p>
      <div class="badges" aria-label="Experiencia y especialidades">
        {badges.map((badge) => <span class="badge">{badge}</span>)}
      </div>
    </div>
    <div class="side">
      <span class="side-number" aria-hidden="true">01 / PERFIL</span>
      <p>AdTech para conectar tecnología, medios y publicidad.</p>
      <a class="cta" href="/José Antonio López Molina · CV.pdf" download>
        Descargar CV <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.concept .close');
    button?.closest('.concept')?.remove();
  });
</script>

<style>
  .concept {
    --paper: #fff;
    --ink: #1a1d23;
    --muted: #45484e;
    --accent: #806000;
    --panel: #f1f3f5;
    --rule: #c6c9cc;
    position: relative;
    box-sizing: border-box;
    width: 980px;
    height: 250px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  .concept.dark {
    --paper: #1a1d23;
    --ink: #fff;
    --muted: #e1e2e5;
    --accent: #f3d34d;
    --panel: #292d34;
    --rule: #62666d;
  }
  .topline {
    height: 35px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    padding-left: 22px;
    border-bottom: 1px solid var(--rule);
  }
  .advertiser, .ad-label, .kicker, .side-number {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
  }
  .advertiser { color: var(--muted); }
  .controls { display: flex; align-self: stretch; flex: none; }
  .ad-label {
    display: flex;
    align-items: center;
    padding: 0 14px;
    background: var(--ink);
    color: var(--paper);
  }
  .close {
    width: 40px;
    border: 0;
    border-left: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    font: 28px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }
  .close:hover { background: var(--rule); }
  .close:focus-visible, .cta:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    height: calc(100% - 35px);
  }
  .message {
    min-width: 0;
    padding: 16px 26px 12px;
    border-left: 5px solid var(--accent);
  }
  .kicker { color: var(--accent); }
  h2 {
    margin: 7px 0 5px;
    font: 700 32px/1.04 Georgia, 'Times New Roman', serif;
    letter-spacing: -.025em;
  }
  .period { color: var(--accent); }
  .message p {
    margin: 0 0 11px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.35;
  }
  .badges { display: flex; flex-wrap: wrap; gap: 5px; }
  .badge {
    padding: 4px 7px;
    border: 1px solid var(--rule);
    color: var(--ink);
    background: var(--panel);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
  }
  .side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px 19px;
    border-left: 1px solid var(--rule);
    background: var(--panel);
  }
  .side-number { color: var(--muted); }
  .side p {
    margin: 0;
    font: 700 20px/1.18 Georgia, 'Times New Roman', serif;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    padding: 0 13px;
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover { text-decoration: underline; }
  @media (max-width: 979px) {
    .concept { width: 100%; height: auto; min-height: 250px; }
    .body { height: auto; min-height: 214px; }
  }
  @media (max-width: 700px) {
    .body { display: block; }
    .message { padding: 20px 16px; }
    .side { gap: 14px; padding: 16px; border-left: 0; border-top: 1px solid var(--rule); }
    .side p { font-size: 17px; }
    h2 { font-size: clamp(26px, 8vw, 32px); }
  }
  @media (max-width: 390px) {
    .topline { padding-left: 8px; }
    .advertiser, .ad-label { font-size: 9px; letter-spacing: 0; }
    .ad-label { padding: 0 7px; }
  }
</style>
