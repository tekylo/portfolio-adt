---
interface Props {
  theme: 'light' | 'dark';
}

const { theme } = Astro.props;
const groups = [
  { label: 'Advertising & Data', items: ['Google Ad Manager', 'Header Bidding', 'Prebid.js', 'Tag Manager'] },
  { label: 'Frontend', items: ['Astro', 'React', 'TypeScript', 'TailwindCSS'] },
  { label: 'Backend & DevOps', items: ['Node.js', 'PHP / Symfony', 'Docker', 'AWS'] },
];
---

<section class:list={['skyscraper', theme]} aria-label="Anuncio de conocimientos del portfolio de José Antonio López Molina">
  <div class="topline">
    <span class="advertiser">JOSÉ ANTONIO / PORTFOLIO</span>
    <div class="controls">
      <span class="ad-label">ANUNCIO</span>
      <button class="close" type="button" aria-label="Cerrar anuncio de conocimientos">×</button>
    </div>
  </div>

  <header class="intro">
    <span class="eyebrow">EDICIÓN / CONOCIMIENTOS</span>
    <h2>Stack Tecnológico<br />AdTech<span>.</span></h2>
    <p>Tecnologías que utilizo para conectar publicidad digital y desarrollo.</p>
  </header>

  <div class="groups" aria-label="Tecnologías por especialidad">
    {groups.map((group, index) => (
      <section class="group" aria-label={group.label}>
        <div class="group-heading">
          <span class="number">0{index + 1}</span>
          <h3>{group.label}</h3>
        </div>
        <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
      </section>
    ))}
  </div>

  <footer>
    <span class="footer-note">HERRAMIENTAS / PRÁCTICA</span>
    <a class="cta" href="/articulo-conocimientos">Ver conocimientos <span aria-hidden="true">↗</span></a>
  </footer>
</section>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.skyscraper .close');
    button?.closest('.skyscraper')?.remove();
  });
</script>

<style>
  .skyscraper {
    --paper: #fff;
    --ink: #1a1d23;
    --muted: #45484e;
    --accent: #806000;
    --panel: #f8f9fa;
    --rule: #c6c9cc;
    box-sizing: border-box;
    position: relative;
    width: 300px;
    height: 600px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  .skyscraper.dark {
    --paper: #1a1d23;
    --ink: #fff;
    --muted: #e1e2e5;
    --accent: #f3d34d;
    --panel: #292d34;
    --rule: #62666d;
  }
  .topline {
    box-sizing: border-box;
    height: 36px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-left: 10px;
  }
  .advertiser, .ad-label, .eyebrow, .footer-note {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .04em;
  }
  .advertiser { color: var(--muted); }
  .controls { display: flex; align-self: stretch; flex: none; }
  .ad-label {
    display: flex;
    align-items: center;
    padding: 0 8px;
    background: var(--ink);
    color: var(--paper);
  }
  .close {
    width: 36px;
    border: 0;
    border-left: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    font: 26px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }
  .close:hover { background: var(--rule); }
  .close:focus-visible, .cta:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .intro { padding: 17px 17px 12px; border-left: 4px solid var(--accent); }
  .eyebrow { color: var(--accent); }
  h2 {
    margin: 7px 0 6px;
    font: 700 26px/1.08 Georgia, 'Times New Roman', serif;
    letter-spacing: -.03em;
  }
  h2 span { color: var(--accent); }
  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.35;
  }
  .groups { display: flex; flex-direction: column; gap: 7px; padding: 0 13px; }
  .group { padding: 8px 10px 9px; background: var(--panel); border: 1px solid var(--rule); }
  .group-heading { display: flex; align-items: baseline; gap: 7px; border-bottom: 1px solid var(--rule); padding-bottom: 5px; }
  .number { color: var(--accent); font: 700 14px/1 Georgia, 'Times New Roman', serif; }
  h3 { margin: 0; font-size: 12px; line-height: 1.2; letter-spacing: .02em; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 5px; margin: 7px 0 0; padding: 0; list-style: none; }
  li { font-size: 11px; line-height: 1.2; font-weight: 600; overflow-wrap: anywhere; }
  li::before { content: '▪'; color: var(--accent); margin-right: 3px; }
  footer { margin-top: auto; padding: 10px 13px 14px; }
  .footer-note { display: block; margin-bottom: 6px; color: var(--muted); }
  .cta {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    padding: 0 12px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover { text-decoration: underline; }
  @media (max-width: 299px) {
    .skyscraper { width: 100%; height: auto; min-height: 600px; }
    .advertiser { font-size: 8px; }
  }
</style>
