---
const {
  title = "¿Hablamos de tu proyecto?",
  highlight = "Consultoría AdTech a medida",
  perks = [
    "Implementaciones de Google Ad Manager y Header Bidding",
    "Optimización de revenue para medios premium",
    "Integraciones programáticas y Tag Management",
  ],
  email = "lopezmolinaja@gmail.com",
  phone = "+34 687 873 208",
} = Astro.props;

const sanitizedPhone = phone.replace(/\s+/g, "");
---

<div class="contact-skyscraper">
  <div class="ad-controls">
    <span class="ad-label">ANUNCIO</span>
    <button class="close" type="button" aria-label="Cerrar anuncio de contacto">×</button>
  </div>
  <div class="accent-line"></div>

  <div class="inner">
    <div class="headline">
      <h3>{title}</h3>
      <p class="highlight">{highlight}</p>
    </div>

    <ul class="perks">
      {
        perks.map((perk) => (
          <li>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>{perk}</span>
          </li>
        ))
      }
    </ul>

    <div class="contact-block">
      <span class="label">Contacto directo</span>
      <a class="contact-link" href={`mailto:${email}`}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        {email}
      </a>
      <a class="contact-link" href={`tel:${sanitizedPhone}`}>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 11.1 19.1 19.8 19.8 0 0 1 2.07 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.7 12.7 0 0 0 .7 2.8 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45 12.7 12.7 0 0 0 2.8.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
        {phone}
      </a>
    </div>

    <a class="cta" href={`mailto:${email}`}>
      <span>Reservar una llamada</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.contact-skyscraper .close');
    button?.closest('.contact-skyscraper')?.remove();
  });
</script>

<style>
  .contact-skyscraper {
    width: 300px;
    height: 600px;
    box-sizing: border-box;
    background: var(--bg-secondary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition:
      box-shadow var(--transition-base) var(--ease-default),
      border-color var(--transition-base) var(--ease-default);
  }

  .contact-skyscraper:hover {
    box-shadow: var(--shadow-lg);
  }

  .ad-controls {
    position: absolute;
    top: 0;
    right: 0;
    height: 36px;
    display: flex;
    z-index: 10;
  }

  .ad-label {
    display: flex;
    align-items: center;
    background: var(--text-secondary);
    color: var(--bg-primary);
    padding: 0 8px;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-weight: 700;
  }

  .close {
    width: 36px;
    height: 36px;
    border: 0;
    border-left: 1px solid var(--border-default);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: 26px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }

  .close:hover { background: var(--border-default); }
  .close:focus-visible { outline: 3px solid var(--accent-text); outline-offset: -3px; }

  .accent-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--accent-primary);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    box-sizing: border-box;
    overflow: hidden;
    padding: 48px var(--space-5) var(--space-5);
  }

  .headline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-default);
  }

  h3 {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.25;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .highlight {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-text);
  }

  .perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .perks li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--text-primary);
  }

  .perks li svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--accent-primary);
  }

  .contact-block {
    padding: var(--space-4);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    font-weight: 600;
    color: var(--accent-text);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-default);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    text-decoration: none;
    color: var(--text-primary);
    transition: color var(--transition-base) var(--ease-default);
  }

  .contact-link:hover {
    color: var(--accent-primary);
  }

  .contact-link svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .cta {
    margin-top: auto;
    background: var(--accent-primary);
    color: var(--accent-foreground);
    border: none;
    border-radius: 0;
    min-height: 40px;
    box-sizing: border-box;
    padding: 0 12px;
    font-weight: 700;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    cursor: pointer;
  }

  .cta:hover { text-decoration: underline; }

  .cta:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: -3px;
  }

  @media (max-width: 1100px) {
    .contact-skyscraper {
      display: none;
    }
  }
</style>
