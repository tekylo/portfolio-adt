---
import type { AstroBuiltinProps } from "astro";

export interface Testimonial {
  name: string;
  role: string;
  quote: string;
  ctaLabel: string;
  href: string;
  theme?: "dark" | "light";
}

export interface Props extends AstroBuiltinProps {
  testimonial?: Testimonial;
}

const {
  testimonial = {
    name: "Nombre Apellido",
    role: "Cargo · Organización",
    quote:
      "José Antonio aporta una combinación única de visión estratégica y excelencia técnica en cada proyecto que lidera.",
    ctaLabel: "Leer testimonio",
    href: "#",
    theme: "dark",
  },
} = Astro.props;

const themeClass = testimonial.theme === "light" ? "theme-light" : "theme-dark";
---

<aside class={`testimonial-ad ${themeClass}`}>
  <div class="accent-line"></div>
  <div class="controls">
    <span class="ad-label">ANUNCIO</span>
    <button class="close" type="button" aria-label="Cerrar anuncio de testimonio">×</button>
  </div>

  <div class="inner">
    <div class="quote-mark">“</div>

    <div class="content">
      <p class="quote">{testimonial.quote}</p>

      <div class="author">
        <span class="name">{testimonial.name}</span>
        <span class="role">{testimonial.role}</span>
      </div>

      <a
        href={testimonial.href}
        target="_blank"
        rel="noopener noreferrer"
        class="cta"
      >
        {testimonial.ctaLabel}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</aside>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    target.closest<HTMLButtonElement>('.testimonial-ad .close')?.closest('.testimonial-ad')?.remove();
  });
</script>

<style>
  .testimonial-ad {
    position: relative;
    border-radius: 6px;
    padding: 3rem 2.5rem 2.5rem;
    margin: 2.5rem 0;
    overflow: hidden;
    box-shadow: none;
    border: 1px solid var(--border-default);
  }

  .theme-dark {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .theme-light {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .accent-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--accent-text);
  }

  .controls {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    height: 35px;
  }

  .ad-label {
    display: flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    background: var(--text-secondary);
    color: var(--bg-primary);
    padding: 0 8px;
    border-radius: 0;
  }

  .close {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 35px;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border-default);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: 26px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }

  .close:hover { background: var(--border-default); }
  .close:focus-visible { outline: 3px solid var(--accent-text); outline-offset: -3px; }

  .theme-light .ad-label {
    background: var(--text-secondary);
  }

  .inner {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .quote-mark {
    font-size: 5rem;
    font-family: var(--font-display);
    line-height: 0.7;
    color: var(--accent-text);
    opacity: 0.85;
  }

  .content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .quote {
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.5;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .author {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .name {
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .role {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    box-sizing: border-box;
    align-self: flex-start;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 0;
    text-decoration: none;
    font-weight: 700;
    font-size: 12px;
  }

  .theme-dark .cta,
  .theme-light .cta {
    background: var(--accent-primary);
    color: var(--accent-foreground);
  }

  .cta:hover {
    background: var(--accent-hover);
    text-decoration: underline;
  }

  .cta:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: -3px;
  }

  @media (max-width: 768px) {
    .testimonial-ad {
      min-width: 0;
      padding: 3rem 1.5rem 1.5rem;
      margin: 2rem 0;
    }

    .inner {
      flex-direction: column;
      gap: 1rem;
    }

    .quote-mark {
      font-size: 4rem;
    }

    .quote {
      font-size: 1.2rem;
    }

    .cta {
      max-width: 100%;
      box-sizing: border-box;
      overflow-wrap: anywhere;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .testimonial-ad {
      padding: 3rem 1rem 1rem;
    }

    .quote {
      font-size: 1.1rem;
    }
  }
</style>
