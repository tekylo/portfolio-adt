---
export interface Publication {
  title: string;
  summary: string;
  ctaLabel: string;
  href: string;
  theme?: "dark" | "light";
}

export interface Props {
  publication?: Publication;
}

const {
  publication = {
    title: "Título de la publicación",
    summary:
      "Resumen breve del contenido para invitar a leer el artículo completo en la plataforma original.",
    ctaLabel: "Leer publicación",
    href: "#",
    theme: "dark",
  },
} = Astro.props;

const themeClass =
  publication.theme === "light" ? "publication-theme-light" : "publication-theme-dark";
---

<section class={`publication-ad ${themeClass}`}>
  <div class="accent-line"></div>
  <div class="controls">
    <span class="label">ANUNCIO</span>
    <button class="close" type="button" aria-label="Cerrar anuncio de publicación">×</button>
  </div>
  <div class="content">
    <div class="copy-block">
      <h3>{publication.title}</h3>
      <p>{publication.summary}</p>
    </div>
    <a
      href={publication.href}
      target="_blank"
      rel="noopener noreferrer"
      class="cta"
    >
      {publication.ctaLabel}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    target.closest<HTMLButtonElement>('.publication-ad .close')?.closest('.publication-ad')?.remove();
  });
</script>

<style>
  .publication-ad {
    position: relative;
    width: 728px;
    height: 90px;
    margin: 3rem auto;
    padding: 10px 18px 10px 22px;
    box-sizing: border-box;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border-default);
    box-shadow: none;
  }

  .publication-theme-dark {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .publication-theme-light {
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .accent-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--accent-text);
  }

  .controls {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    height: 36px;
    z-index: 1;
  }

  .label {
    display: flex;
    align-items: center;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    background: var(--text-secondary);
    color: var(--bg-primary);
    padding: 0.28rem 0.55rem;
    border-radius: 0 0 0 var(--radius-sm);
  }

  .close {
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border-default);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: 26px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }

  .close:hover { background: var(--border-default); }
  .close:focus-visible { outline: 3px solid var(--accent-text); outline-offset: -3px; }

  .publication-theme-light .label {
    background: var(--text-secondary);
  }

  .content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .copy-block {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    flex: 1;
    padding-right: 110px;
    box-sizing: border-box;
  }

  h3 {
    font-size: 1.02rem;
    margin: 0;
    font-family: var(--font-display);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
    max-width: none;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .content p {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.2;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    min-width: 140px;
    min-height: 40px;
    align-self: flex-end;
    padding: 0 12px;
    border-radius: 0;
    text-decoration: none;
    font-weight: 700;
    font-size: 12px;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .publication-theme-dark .cta,
  .publication-theme-light .cta {
    background: var(--accent-primary);
    color: var(--accent-foreground);
  }

  .cta:hover {
    text-decoration: underline;
  }

  .cta:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: -3px;
  }

  .publication-theme-dark .cta:hover {
    background: var(--accent-hover);
  }

  .publication-theme-light .cta:hover {
    background: var(--accent-hover);
  }

  @media (max-width: 768px) {
    .publication-ad {
      width: 100%;
      height: auto;
      min-height: 90px;
      padding: 2.5rem 1rem 1rem 1.25rem;
      margin: 2.5rem 0;
    }

    .copy-block { padding-right: 0; }

    .content {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      height: auto;
    }

    h3 {
      font-size: 1.05rem;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .content p {
      font-size: 0.85rem;
    }

    .cta {
      width: 100%;
      min-width: 0;
      align-self: flex-start;
      justify-content: space-between;
    }
  }
</style>
