---
import LogosGoogleTagManager from '../../../svgs/LogosGoogleTagManager.astro';
import LogosAstroIcon from '../../../svgs/LogosAstroIcon.astro';
import LogosReact from '../../../svgs/LogosReact.astro';
import LogosTypescriptIcon from '../../../svgs/LogosTypescriptIcon.astro';
import LogosTailwindcssIcon from '../../../svgs/LogosTailwindcssIcon.astro';
import LogosNodejs from '../../../svgs/LogosNodejs.astro';
import LogosPhp from '../../../svgs/LogosPhp.astro';
import LogosSymfony from '../../../svgs/LogosSymfony.astro';
import LogosDockerIcon from '../../../svgs/LogosDockerIcon.astro';
import LogosAws from '../../../svgs/LogosAws.astro';
import LucideLayoutDashboard from '../../../svgs/LucideLayoutDashboard.astro';
import LucideGavel from '../../../svgs/LucideGavel.astro';
import LucideArrowLeftRight from '../../../svgs/LucideArrowLeftRight.astro';
import LucideCodeXml from '../../../svgs/LucideCodeXml.astro';
import LucideNetwork from '../../../svgs/LucideNetwork.astro';
import LucideBraces from '../../../svgs/LucideBraces.astro';
import LogosMysql from '../../../svgs/LogosMysql.astro';
import LogosAngularJsLegacy from '../../../svgs/LogosAngularJsLegacy.astro';
import LogosPrebidJsProduct from '../../../svgs/LogosPrebidJsProduct.astro';
import LogosXandrEmblem from '../../../svgs/LogosXandrEmblem.astro';

interface Props {
  theme: 'light' | 'dark' | 'auto';
  variant?: 'icons' | 'expanded' | 'icons-expanded';
  look?: 'current' | 'site';
  clean?: boolean;
}

const { theme, variant = 'icons', look = 'current', clean = false } = Astro.props;
const groups = [
  { label: 'Advertising & Data', items: [
    { name: 'Google Ad Manager', icon: LucideLayoutDashboard },
    { name: 'Header Bidding', icon: LucideGavel },
    { name: 'Prebid.js', icon: LucideCodeXml },
    { name: 'Tag Manager', icon: LogosGoogleTagManager },
  ], extra: { name: 'Xandr', icon: LucideNetwork } },
  { label: 'Frontend', items: [
    { name: 'Astro', icon: LogosAstroIcon },
    { name: 'React', icon: LogosReact },
    { name: 'TypeScript', icon: LogosTypescriptIcon },
    { name: 'TailwindCSS', icon: LogosTailwindcssIcon },
  ], extra: { name: 'AngularJS', icon: LucideBraces } },
  { label: 'Backend & DevOps', items: [
    { name: 'Node.js', icon: LogosNodejs },
    { name: 'PHP / Symfony', icon: LogosPhp, secondIcon: LogosSymfony },
    { name: 'Docker', icon: LogosDockerIcon },
    { name: 'AWS', icon: LogosAws },
  ], extra: { name: 'MySQL', icon: LogosMysql } },
];
---

<section class:list={['skyscraper', theme, variant, look, { clean }]} aria-label="Anuncio de conocimientos del portfolio de José Antonio López Molina">
  <div class="topline">
    {!clean && <span class="advertiser">CONOCIMIENTOS · PORTFOLIO</span>}
    <div class="controls">
      <span class="ad-label">ANUNCIO</span>
      <button class="close" type="button" aria-label="Cerrar anuncio de conocimientos">×</button>
    </div>
  </div>

  <header class="intro">
    <span class="eyebrow">EDICIÓN / CONOCIMIENTOS</span>
    <h2>Stack Tecnológico<br />AdTech<span>.</span></h2>
    <p>Tecnologías que utilizo para conectar publicidad digital y desarrollo.</p>
  </header>

  <div class="groups" aria-label="Tecnologías por especialidad">
    {groups.map((group, index) => (
      <section class="group" aria-label={group.label}>
        <div class="group-heading">
          {!clean && <span class="number">0{index + 1}</span>}
          <h3>{group.label}</h3>
        </div>
        <ul>
          {group.items.map((item) => {
            const shownItem = variant === 'icons-expanded' && item.name === 'Header Bidding'
              ? { name: 'OpenRTB', icon: LucideArrowLeftRight }
              : variant === 'icons-expanded' && item.name === 'Prebid.js'
                ? { ...item, icon: LogosPrebidJsProduct }
                : item;
            return (
              <li>
                {variant !== 'expanded' && <span class="icon" aria-hidden="true"><shownItem.icon aria-hidden="true" />{item.secondIcon && <item.secondIcon aria-hidden="true" />}</span>}
                <span>{shownItem.name}</span>
              </li>
            );
          })}
          {variant === 'expanded' && <li>{group.extra.name}</li>}
          {variant === 'icons-expanded' && <li><span class="icon" aria-hidden="true">{group.extra.name === 'Xandr'
            ? <LogosXandrEmblem aria-hidden="true" />
            : group.extra.name === 'AngularJS'
              ? <LogosAngularJsLegacy aria-hidden="true" />
              : <group.extra.icon aria-hidden="true" />}</span><span>{group.extra.name}</span></li>}
        </ul>
      </section>
    ))}
  </div>

  <footer>
    {!clean && <span class="footer-note">HERRAMIENTAS / PRÁCTICA</span>}
    <a class="cta" href="/articulo-conocimientos">Ver conocimientos <span aria-hidden="true">↗</span></a>
  </footer>
</section>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.skyscraper .close');
    button?.closest('.skyscraper')?.remove();
  });
</script>

<style>
  .skyscraper {
    --paper: #fff;
    --ink: #1a1d23;
    --muted: #45484e;
    --accent: #806000;
    --panel: #f8f9fa;
    --rule: #c6c9cc;
    box-sizing: border-box;
    position: relative;
    width: 300px;
    height: 600px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    border-radius: 6px;
    overflow: hidden;
    font-family: var(--font-body, system-ui, sans-serif);
  }
  .skyscraper.dark, :global(html.dark) .skyscraper.auto {
    --paper: #1a1d23;
    --ink: #fff;
    --muted: #e1e2e5;
    --accent: #f3d34d;
    --panel: #292d34;
    --rule: #62666d;
  }
  .skyscraper.site, .skyscraper.dark.site, :global(html.dark) .skyscraper.auto.site {
    --paper: var(--bg-secondary);
    --ink: var(--text-primary);
    --muted: var(--text-secondary);
    --accent: var(--accent-text);
    --panel: var(--bg-tertiary);
    --rule: var(--border-default);
  }
  .topline {
    box-sizing: border-box;
    height: 36px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-left: 10px;
  }
  .advertiser, .ad-label, .eyebrow, .footer-note {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .04em;
  }
  .advertiser { color: var(--muted); }
  .clean .topline {
    position: absolute;
    top: 0;
    right: 0;
    height: 35px;
    padding-left: 0;
    border-bottom: 0;
    z-index: 2;
  }
  .controls { display: flex; align-self: stretch; flex: none; }
  .ad-label {
    display: flex;
    align-items: center;
    padding: 0 8px;
    background: var(--ink);
    color: var(--paper);
  }
  .close {
    width: 36px;
    border: 0;
    border-left: 1px solid var(--rule);
    background: var(--panel);
    color: var(--ink);
    font: 26px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }
  .close:hover { background: var(--rule); }
  .close:focus-visible, .cta:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .intro { padding: 17px 17px 12px; border-left: 4px solid var(--accent); }
  .eyebrow { color: var(--accent); }
  h2 {
    margin: 7px 0 6px;
    font: 700 26px/1.08 var(--font-display, Georgia, 'Times New Roman', serif);
    letter-spacing: -.03em;
  }
  h2 span { color: var(--accent); }
  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.35;
  }
  .clean .intro .eyebrow { display: inline-block; max-width: calc(100% - 100px); }
  .clean .intro h2 { margin-top: 15px; }
  .groups { display: flex; flex-direction: column; gap: 7px; padding: 0 13px; }
  .group { padding: 8px 10px 9px; background: var(--panel); border: 1px solid var(--rule); }
  .group-heading { display: flex; align-items: baseline; gap: 7px; border-bottom: 1px solid var(--rule); padding-bottom: 5px; }
  .number { color: var(--accent); font: 700 14px/1 var(--font-display, Georgia, 'Times New Roman', serif); }
  h3 { margin: 0; font-size: 12px; line-height: 1.2; letter-spacing: .02em; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 5px; margin: 7px 0 0; padding: 0; list-style: none; }
  li { font-size: 11px; line-height: 1.2; font-weight: 600; overflow-wrap: anywhere; }
  .expanded li::before { content: '▪'; color: var(--accent); margin-right: 3px; }
  .icons li, .icons-expanded li { display: flex; align-items: center; gap: 5px; min-height: 23px; }
  .icon { flex: none; display: flex; align-items: center; justify-content: center; gap: 1px; width: 20px; height: 20px; background: #fff; border-radius: 3px; color: #1a1d23; }
  .icon :global(svg) { max-width: 17px; max-height: 17px; width: auto; height: auto; }
  .icon:has(:global(svg + svg)) :global(svg) { max-width: 9px; max-height: 16px; }
  .site .advertiser, .site .ad-label, .site .eyebrow, .site .footer-note { font-size: 10px; letter-spacing: .02em; }
  .site .ad-label { background: var(--text-secondary); color: var(--bg-primary); }
  .site .icon { box-sizing: border-box; border: 1px solid var(--border-subtle); background: var(--bg-tertiary); color: var(--text-primary); }
  .skyscraper.dark.site .icon, :global(html.dark) .skyscraper.auto.site .icon { background: var(--text-secondary); color: var(--accent-foreground); }
  .site .cta { background: var(--accent-primary); color: var(--accent-foreground); }
  .site .close { background: var(--bg-secondary); }
  .icons-expanded .intro { padding-top: 12px; padding-bottom: 8px; }
  .icons-expanded .groups { gap: 4px; }
  .icons-expanded .group { padding-top: 4px; padding-bottom: 4px; }
  .icons-expanded .group-heading { padding-bottom: 3px; }
  .icons-expanded ul { gap: 3px 4px; margin-top: 4px; }
  .clean.icons-expanded .groups { gap: 8px; }
  .clean.icons-expanded .group { padding-block: 8px; }
  .clean.icons-expanded ul { gap: 4px; }
  .icons .groups { gap: 5px; }
  .icons .group { padding-top: 6px; padding-bottom: 6px; }
  .icons ul { gap: 5px 4px; }
  .expanded .groups { gap: 5px; }
  .expanded .group { padding-top: 6px; padding-bottom: 6px; }
  .expanded ul { gap: 5px 4px; }
  footer { margin-top: auto; padding: 10px 13px 14px; }
  .footer-note { display: block; margin-bottom: 6px; color: var(--muted); }
  .cta {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    padding: 0 12px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  .cta:hover { text-decoration: underline; }
  @media (max-width: 480px) {
    .skyscraper.auto { width: min(300px, 100%); height: auto; min-height: 600px; }
  }
  @media (max-width: 299px) {
    .skyscraper { width: 100%; height: auto; min-height: 600px; }
    .advertiser { font-size: 8px; }
  }
</style>
