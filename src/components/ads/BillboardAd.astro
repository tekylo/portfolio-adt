---
// Formato IAB Megabanner: 980x250
export interface Props {
  headline?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  badges?: string[];
  compact?: boolean;
}

const {
  headline = "José Antonio López Molina",
  description = "Diseño e integro soluciones publicitarias para medios digitales.",
  ctaText = "Descargar CV",
  ctaLink = "/José Antonio López Molina · CV.pdf",
  badges = ["8+ años", "Google Ad Manager", "Header Bidding", "Xandr", "Programática"],
  compact = false,
} = Astro.props;
---

<div class:list={['billboard-ad', { compact }]}>
  <div class="ad-controls">
    <span class="ad-label">ANUNCIO</span>
    <button class="close" type="button" aria-label="Cerrar anuncio de currículum">×</button>
  </div>

  <div class="billboard-content">
    <div class="billboard-text">
      <span class="eyebrow">AdTech · Arquitectura publicitaria</span>
      <h2 class="headline">{headline}</h2>
      <p class="compact-role">Especialista en AdTech y arquitectura publicitaria</p>
      <p class="description">{description}</p>

      <div class="badges">
        {badges.map((badge) => (
          <span class="badge">{badge}</span>
        ))}
      </div>
    </div>

    <div class="billboard-side">
      <div class="side-panel">
        <span class="side-kicker">Especialización</span>
        <div class="side-metrics" aria-hidden="true">
          <span>GAM</span>
          <span>HB</span>
          <span>OpenRTB</span>
        </div>
        <a href={ctaLink} class="cta-btn" download>
          <span>{ctaText}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  
  <div class="billboard-decor">
    <div class="accent-bar"></div>
  </div>
</div>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('.billboard-ad .close');
    button?.closest('.billboard-ad')?.remove();
  });
</script>

<style>
  .billboard-ad {
    position: relative;
    width: 980px;
    height: 250px;
    margin: var(--space-8) auto;
    background: var(--bg-secondary);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-sizing: border-box;
    transition:
      border-color var(--transition-base) var(--ease-default),
      box-shadow var(--transition-base) var(--ease-default),
      transform var(--transition-base) var(--ease-default);
  }

  .billboard-ad:hover {
    border-color: var(--border-default);
    box-shadow: var(--shadow-md);
  }

  .ad-controls {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    height: 35px;
    z-index: 2;
  }

  .ad-label {
    display: flex;
    align-items: center;
    background: var(--text-secondary);
    color: var(--bg-primary);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0 8px;
  }

  .close {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 35px;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--border-default);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: 26px/1 Arial, Helvetica, sans-serif;
    cursor: pointer;
  }

  .close:hover { background: var(--border-default); }
  .close:focus-visible { outline: 3px solid var(--accent-text); outline-offset: -3px; }

  .billboard-content {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(220px, 0.75fr);
    align-items: stretch;
    width: 100%;
    height: 100%;
    padding: 40px 28px 20px 32px;
    gap: 24px;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }

  .billboard-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 580px;
    min-width: 0;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .headline {
    font-family: var(--font-display);
    font-size: 2.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    line-height: 1.02;
    max-width: 12ch;
    transition: color var(--transition-base) var(--ease-default);
  }

  .description {
    font-size: 0.98rem;
    color: var(--text-secondary);
    margin: 0 0 14px 0;
    font-style: italic;
    max-width: 46ch;
    line-height: 1.35;
  }

  .compact-role { display: none; }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .badge {
    display: inline-block;
    background: rgba(212, 160, 23, 0.12);
    color: var(--accent-text);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 160, 23, 0.25);
    transition:
      background-color var(--transition-base) var(--ease-default),
      border-color var(--transition-base) var(--ease-default);
  }

  .badge:hover {
    background: rgba(212, 160, 23, 0.2);
    border-color: rgba(212, 160, 23, 0.4);
  }

  .billboard-side {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
  }

  .side-panel {
    width: 100%;
    min-width: 220px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-default);
    border-top: 3px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    padding: 18px 16px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
  }

  .side-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-default);
  }

  .side-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .side-metrics span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    color: var(--accent-text);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 40px;
    background: var(--accent-primary);
    color: var(--accent-foreground);
    border: none;
    border-radius: 0;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .cta-btn:hover { text-decoration: underline; }

  .cta-btn:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: -3px;
  }

  .billboard-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--space-1);
    height: 100%;
    background: var(--accent-primary);
  }

  /* Responsive - Tablet */
  @media (max-width: 900px) {
    .billboard-content {
      grid-template-columns: minmax(0, 1fr) 220px;
      padding: 40px 24px 20px;
      gap: 18px;
    }

    .headline {
      font-size: 1.85rem;
    }

    .description {
      font-size: 0.92rem;
    }
  }

  @media (min-width: 601px) and (max-width: 980px) {
    .side-metrics span:last-child { font-size: 0.7rem; }
  }

  /* Responsive - Mobile */
  @media (max-width: 600px) {
    .billboard-ad {
      width: 100%;
      height: auto;
      min-height: 250px;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }

    .billboard-content {
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 250px;
      padding: 48px var(--space-4) var(--space-5);
      gap: var(--space-4);
      text-align: center;
    }

    .billboard-text {
      text-align: center;
      max-width: none;
    }

    .eyebrow {
      align-self: center;
    }

    .headline {
      font-size: var(--text-xl);
      max-width: none;
    }

    .description {
      font-size: var(--text-sm);
      max-width: none;
    }

    .badges {
      justify-content: center;
    }

    .badge {
      font-size: 0.6rem;
    }

    .billboard-side {
      width: 100%;
    }

    .side-panel {
      min-width: 0;
    }

    .cta-btn { width: 100%; }

    .compact.billboard-ad { min-height: 0; }
    .compact .billboard-content {
      min-height: 0;
      padding: 48px var(--space-4) var(--space-4);
      gap: 12px;
      text-align: left;
    }
    .compact .billboard-text { text-align: left; }
    .compact .eyebrow,
    .compact .description,
    .compact .badges,
    .compact .side-kicker,
    .compact .side-metrics { display: none; }
    .compact .headline { margin-bottom: 6px; }
    .compact .compact-role {
      display: block;
      margin: 0;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      line-height: 1.35;
    }
    .compact .side-panel { border: 0; background: transparent; padding: 0; }
  }
</style>