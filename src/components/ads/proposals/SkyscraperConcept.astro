---
interface Props {
  theme: 'light' | 'dark';
}

const { theme } = Astro.props;
---

<section class:list={['skyscraper', theme]} aria-label="Anuncio del portfolio de José Antonio López Molina">
  <div class="topline">
    <span>JOSÉ ANTONIO <b>/</b> PORTFOLIO</span>
    <span class="ad-label">ANUNCIO</span>
  </div>

  <div class="intro">
    <span class="eyebrow">ARQUITECTURA ADTECH</span>
    <h2>Del bid al<br />publisher<span>.</span></h2>
    <p>Integraciones que conectan la subasta con la experiencia editorial.</p>
  </div>

  <div class="flow" aria-label="Ruta visual: subasta, adserver e integración publisher">
    <div class="flow-title">RUTA DE INTEGRACIÓN <span aria-hidden="true">↘</span></div>
    <div class="step"><span class="index">01</span><span><strong>SUBASTA</strong><small>Prebid.js · OpenRTB / Xandr</small></span></div>
    <div class="connector" aria-hidden="true"></div>
    <div class="step"><span class="index">02</span><span><strong>ADSERVER</strong><small>Google Ad Manager</small></span></div>
    <div class="connector" aria-hidden="true"></div>
    <div class="step"><span class="index">03</span><span><strong>PUBLISHER</strong><small>Integración multisite</small></span></div>
  </div>

  <div class="footer">
    <p>Arquitectura publicitaria con visión de producto.</p>
    <a href="/articulo-experiencia">Ver experiencia <span aria-hidden="true">↗</span></a>
  </div>
  <div class="edge" aria-hidden="true"></div>
</section>

<style>
  .skyscraper {
    --paper: #f5f0e5;
    --ink: #1b3030;
    --muted: #465b57;
    --accent: #89501f;
    --panel: #e5dfd0;
    --rule: #a6b3a8;
    box-sizing: border-box;
    position: relative;
    isolation: isolate;
    width: 300px;
    height: 600px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  .skyscraper.dark {
    --paper: #142728;
    --ink: #f6f0df;
    --muted: #c9d6cf;
    --accent: #efbd72;
    --panel: #203c3b;
    --rule: #5c8077;
  }
  .topline {
    height: 44px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-left: 15px;
    border-bottom: 1px solid var(--rule);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .08em;
  }
  .topline b { color: var(--accent); padding: 0 3px; }
  .ad-label {
    align-self: stretch;
    display: flex;
    align-items: center;
    padding: 0 10px;
    background: var(--ink);
    color: var(--paper);
  }
  .intro { padding: 26px 22px 20px; }
  .eyebrow, .flow-title, .step strong {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
  }
  .eyebrow { color: var(--accent); }
  h2 {
    margin: 12px 0 11px;
    font: 700 36px/1.03 Georgia, 'Times New Roman', serif;
    letter-spacing: -.04em;
  }
  h2 span { color: var(--accent); }
  .intro p, .footer p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
  }
  .flow {
    margin: 0 15px;
    padding: 16px 14px 17px;
    background: var(--panel);
    border: 1px solid var(--rule);
  }
  .flow-title {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    color: var(--muted);
  }
  .flow-title span { color: var(--accent); font-size: 16px; line-height: .7; }
  .step { display: flex; gap: 12px; align-items: center; }
  .index {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
  }
  .step strong, .step small { display: block; }
  .step small { margin-top: 3px; color: var(--muted); font-size: 10px; }
  .connector { height: 16px; margin: 2px 0 2px 15px; border-left: 1px solid var(--accent); }
  .footer { margin-top: auto; padding: 17px 22px 24px; }
  .footer p { margin-bottom: 13px; }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .edge { position: absolute; bottom: 0; width: 100%; height: 4px; background: var(--accent); }
  @media (max-width: 299px) {
    .skyscraper { max-width: 100%; }
  }
</style>
